{
  "name": "@travories/brochure-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env watch src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "vercel-build": "esbuild src/vercel.ts --bundle --platform=node --target=node22 --format=cjs --outfile=api/index.cjs --footer:js=\"module.exports=module.exports.default\""
  },
  "exports": {
    ".": "./src/brochure/index.ts",
    "./server": "./src/server.ts"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.6.1",
    "fastify": "^5.6.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
